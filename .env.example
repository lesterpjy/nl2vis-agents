# Copy to .env and fill in. .env is git-ignored and is the only place a secret belongs.

# --- required ---------------------------------------------------------------
# The only variable the system cannot run without: the provider key pydantic-ai uses.
OPENAI_API_KEY=sk-...

# --- who may sign in --------------------------------------------------------
# One token per seeded user, DATA_AGENTS_TOKEN_<NAME> upper-cased (system/auth.py).
# The store holds users and grants but never a secret, so a new user needs a line here too.
DATA_AGENTS_TOKEN_ALICE=alice-demo-token
DATA_AGENTS_TOKEN_BOB=bob-demo-token
DATA_AGENTS_TOKEN_ADMIN=admin-demo-token

# --- a model per stage (pydantic-ai model strings) --------------------------
# ANALYSIS_MODEL=openai:gpt-4.1
# VISUALIZATION_MODEL=openai:gpt-4.1-mini
# ROUTER_MODEL=openai:gpt-4.1-mini
# SUGGESTION_MODEL=openai:gpt-4.1-mini
# SCHEMA_MODEL=openai:gpt-5.5          # drafting a Schema Document: once per database, offline
# SIMULATED_USER_MODEL=openai:gpt-4.1-mini   # the benchmark's simulated user only

# --- what the Analysis Agent is shown ---------------------------------------
# Schema Document variant: full, no_examples, lean. `lean` drops views and empty tables;
# it measured equal on the eval set at 29% fewer input tokens, which is why it is the default.
# SCHEMA_VARIANT=lean

# --- pacing of the routes that call a model ---------------------------------
# MODEL_CALLS_PER_MINUTE=20   # per user
# TURNS_IN_FLIGHT=4           # per process

# --- where things live ------------------------------------------------------
# REGISTRY_DIR=registry       # databases.yaml, users.yaml, schemas/, system.db, data/
# BENCH_DIR=.bench            # the benchmark's downloads, registry and run files

# --- tracing ----------------------------------------------------------------
# A Logfire token sends spans — the SQL and the rows in them — off this machine. With no
# token nothing is sent and nothing fails: the default is Logfire's own `if-token-present`.
# LOGFIRE_TOKEN=
# Set false to stop spans leaving the machine whatever credentials exist. The test suite
# sets it for itself, so a `pytest` run never exports anything.
# LOGFIRE_SEND_TO_LOGFIRE=false

# --- benchmark ablation -----------------------------------------------------
# 0 withholds the question from the Visualization Agent, so `chart` measures inference
# rather than instruction-following. The benchmark's --blind flag sets it.
# VISUALIZATION_SEES_QUESTION=1
